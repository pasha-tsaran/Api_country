# Токен сообщества VK и ID (например, 123456 или club123456)
VK_GROUP_TOKEN=
VK_GROUP_ID=

# API-ключ с https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Путь к локальной SQLite-базе
DATABASE_PATH=data/weather_bot.sqlite3

# Ваш VK ID, короткий адрес аккаунта или peer_id беседы
VK_FEEDBACK_PEER_ID=

# Необязательно: INFO, DEBUG, WARNING
LOG_LEVEL=INFO
